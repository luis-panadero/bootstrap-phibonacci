{
  "name": "bootstrap-phibonacci",
  "description": "Drop-in replacement for Bootstrap 3.4 with security patches maintained by Phibonacci Creativo.",
  "keywords": [
    "css",
    "js",
    "less",
    "mobile-first",
    "responsive",
    "front-end",
    "framework",
    "web",
    "bootstrap",
    "bootstrap3",
    "phibonacci"
  ],
  "homepage": "https://www.phibonacci-creativo.com/",
  "license": "MIT",
  "moduleType": "globals",
  "main": [
    "less/bootstrap.less",
    "dist/js/bootstrap.js"
  ],
  "ignore": [
    "/.*",
    "_config.yml",
    "CNAME",
    "composer.json",
    "CONTRIBUTING.md",
    "docs",
    "js/tests",
    "test-infra"
  ],
  "dependencies": {
    "jquery": "1.9.1 - 3"
  }
}
